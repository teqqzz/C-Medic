<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_VisaoGeral" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.35.0">
  <bpmn:collaboration id="Collaboration_VisaoGeral">
    <bpmn:participant id="Participant_Utilizador" name="Utilizador (Paciente/Funcionário)" processRef="Process_InteracaoUtilizador" />
    <bpmn:participant id="Participant_SistemaClinica" name="Sistema da Clínica" processRef="Process_ModulosSistema" />
    <bpmn:messageFlow id="Flow_SolicitacaoAgendamento" name="Solicitar Agendamento" sourceRef="Task_SelecionarOpcaoAgendamento" targetRef="StartEvent_ModuloAgendamento" />
    <bpmn:messageFlow id="Flow_SolicitacaoPacientes" name="Gerir Pacientes" sourceRef="Task_SelecionarOpcaoPacientes" targetRef="StartEvent_ModuloPacientes" />
    <bpmn:messageFlow id="Flow_SolicitacaoCadastros" name="Gerir Cadastros" sourceRef="Task_SelecionarOpcaoCadastros" targetRef="StartEvent_ModuloCadastros" />
    <bpmn:messageFlow id="Flow_SolicitacaoAtendimento" name="Realizar Atendimento" sourceRef="Task_SelecionarOpcaoAtendimento" targetRef="StartEvent_ModuloAtendimento" />
    <bpmn:messageFlow id="Flow_SolicitacaoFinanceiro" name="Gerir Financeiro" sourceRef="Task_SelecionarOpcaoFinanceiro" targetRef="StartEvent_ModuloFinanceiro" />
    <bpmn:messageFlow id="Flow_SolicitacaoRelatorios" name="Gerar Relatórios" sourceRef="Task_SelecionarOpcaoRelatorios" targetRef="StartEvent_ModuloRelatorios" />
  </bpmn:collaboration>
  <bpmn:process id="Process_InteracaoUtilizador" name="Interação do Utilizador" isExecutable="false">
    <bpmn:startEvent id="StartEvent_UtilizadorInicia" name="Utilizador Acede ao Sistema" />
    <bpmn:task id="Task_EscolherAcao" name="Utilizador Escolhe Ação Principal" />
    <bpmn:exclusiveGateway id="Gateway_EscolhaModulo" name="Qual Módulo Aceder?" />
    <bpmn:task id="Task_SelecionarOpcaoCadastros" name="Cadastros Gerais" />
    <bpmn:endEvent id="EndEvent_UtilizadorFinaliza" name="Utilizador Sai/Finaliza Ação" />
    <bpmn:sequenceFlow id="Flow_InicioParaEscolha" sourceRef="StartEvent_UtilizadorInicia" targetRef="Task_EscolherAcao" />
    <bpmn:sequenceFlow id="Flow_EscolhaParaGateway" sourceRef="Task_EscolherAcao" targetRef="Gateway_EscolhaModulo" />
    <bpmn:sequenceFlow id="Flow_ParaAgendamentos" name="Agendamentos" sourceRef="Gateway_EscolhaModulo" targetRef="Task_SelecionarOpcaoAgendamento" />
    <bpmn:sequenceFlow id="Flow_ParaPacientes" name="Pacientes" sourceRef="Gateway_EscolhaModulo" targetRef="Task_SelecionarOpcaoPacientes" />
    <bpmn:sequenceFlow id="Flow_ParaCadastros" name="Cadastros" sourceRef="Gateway_EscolhaModulo" targetRef="Task_SelecionarOpcaoCadastros" />
    <bpmn:sequenceFlow id="Flow_ParaAtendimento" name="Atendimentos" sourceRef="Gateway_EscolhaModulo" targetRef="Task_SelecionarOpcaoAtendimento" />
    <bpmn:sequenceFlow id="Flow_ParaFinanceiro" name="Financeiro" sourceRef="Gateway_EscolhaModulo" targetRef="Task_SelecionarOpcaoFinanceiro" />
    <bpmn:sequenceFlow id="Flow_ParaRelatorios" name="Relatórios" sourceRef="Gateway_EscolhaModulo" targetRef="Task_SelecionarOpcaoRelatorios" />
    <bpmn:sequenceFlow id="Flow_AgendamentoParaFim" sourceRef="Task_SelecionarOpcaoAgendamento" targetRef="EndEvent_UtilizadorFinaliza" />
    <bpmn:sequenceFlow id="Flow_PacientesParaFim" sourceRef="Task_SelecionarOpcaoPacientes" targetRef="EndEvent_UtilizadorFinaliza" />
    <bpmn:sequenceFlow id="Flow_CadastrosParaFim" sourceRef="Task_SelecionarOpcaoCadastros" targetRef="EndEvent_UtilizadorFinaliza" />
    <bpmn:sequenceFlow id="Flow_AtendimentoParaFim" sourceRef="Task_SelecionarOpcaoAtendimento" targetRef="EndEvent_UtilizadorFinaliza" />
    <bpmn:sequenceFlow id="Flow_FinanceiroParaFim" sourceRef="Task_SelecionarOpcaoFinanceiro" targetRef="EndEvent_UtilizadorFinaliza" />
    <bpmn:sequenceFlow id="Flow_RelatoriosParaFim" sourceRef="Task_SelecionarOpcaoRelatorios" targetRef="EndEvent_UtilizadorFinaliza" />
    <bpmn:task id="Task_SelecionarOpcaoAgendamento" name="Agendamentos" />
    <bpmn:task id="Task_SelecionarOpcaoPacientes" name="Pacientes" />
    <bpmn:task id="Task_SelecionarOpcaoRelatorios" name="Relatórios" />
    <bpmn:task id="Task_SelecionarOpcaoFinanceiro" name="Financeiro" />
    <bpmn:task id="Task_SelecionarOpcaoAtendimento" name="Atendimentos" />
  </bpmn:process>
  <bpmn:process id="Process_ModulosSistema" name="Módulos do Sistema da Clínica" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ModuloAgendamento" name="Receber Solicitação de Agendamento">
      <bpmn:messageEventDefinition messageRef="Msg_SolicitacaoAgendamento" />
    </bpmn:startEvent>
    <bpmn:subProcess id="SubProcess_GerenciarAgendamentos" name="Gerenciar Agendamentos">
      <bpmn:incoming>Flow_InicioModuloAgendamento</bpmn:incoming>
      <bpmn:outgoing>Flow_FimModuloAgendamento</bpmn:outgoing>
      <bpmn:startEvent id="StartSubAgendamento" />
      <bpmn:task id="Task_LogicaAgendamento" name="Executar Lógica de Agendamentos (Serviços)" />
      <bpmn:endEvent id="EndSubAgendamento" />
      <bpmn:sequenceFlow id="Flow_SubAg_1" sourceRef="StartSubAgendamento" targetRef="Task_LogicaAgendamento" />
      <bpmn:sequenceFlow id="Flow_SubAg_2" sourceRef="Task_LogicaAgendamento" targetRef="EndSubAgendamento" />
    </bpmn:subProcess>
    <bpmn:endEvent id="EndEvent_ModuloAgendamento" name="Resposta de Agendamento Enviada" />
    <bpmn:sequenceFlow id="Flow_InicioModuloAgendamento" sourceRef="StartEvent_ModuloAgendamento" targetRef="SubProcess_GerenciarAgendamentos" />
    <bpmn:sequenceFlow id="Flow_FimModuloAgendamento" sourceRef="SubProcess_GerenciarAgendamentos" targetRef="EndEvent_ModuloAgendamento" />
    <bpmn:startEvent id="StartEvent_ModuloPacientes" name="Receber Solicitação de Gestão de Pacientes">
      <bpmn:messageEventDefinition messageRef="Msg_SolicitacaoPacientes" />
    </bpmn:startEvent>
    <bpmn:subProcess id="SubProcess_GerenciarPacientes" name="Gerenciar Pacientes (CRUD)" />
    <bpmn:endEvent id="EndEvent_ModuloPacientes" name="Resposta de Gestão de Pacientes Enviada" />
    <bpmn:sequenceFlow id="Flow_InicioModuloPacientes" sourceRef="StartEvent_ModuloPacientes" targetRef="SubProcess_GerenciarPacientes" />
    <bpmn:sequenceFlow id="Flow_FimModuloPacientes" sourceRef="SubProcess_GerenciarPacientes" targetRef="EndEvent_ModuloPacientes" />
    <bpmn:startEvent id="StartEvent_ModuloCadastros" name="Receber Solicitação de Gestão de Cadastros">
      <bpmn:messageEventDefinition messageRef="Msg_SolicitacaoCadastros" />
    </bpmn:startEvent>
    <bpmn:subProcess id="SubProcess_GerenciarCadastros" name="Gerenciar Cadastros Gerais (CRUD)" />
    <bpmn:endEvent id="EndEvent_ModuloCadastros" name="Resposta de Gestão de Cadastros Enviada" />
    <bpmn:sequenceFlow id="Flow_InicioModuloCadastros" sourceRef="StartEvent_ModuloCadastros" targetRef="SubProcess_GerenciarCadastros" />
    <bpmn:sequenceFlow id="Flow_FimModuloCadastros" sourceRef="SubProcess_GerenciarCadastros" targetRef="EndEvent_ModuloCadastros" />
    <bpmn:startEvent id="StartEvent_ModuloAtendimento" name="Receber Solicitação de Atendimento">
      <bpmn:messageEventDefinition messageRef="Msg_SolicitacaoAtendimento" />
    </bpmn:startEvent>
    <bpmn:subProcess id="SubProcess_RealizarAtendimento" name="Realizar Atendimento e Gerar Cobrança" />
    <bpmn:endEvent id="EndEvent_ModuloAtendimento" name="Resposta de Atendimento Enviada" />
    <bpmn:sequenceFlow id="Flow_InicioModuloAtendimento" sourceRef="StartEvent_ModuloAtendimento" targetRef="SubProcess_RealizarAtendimento" />
    <bpmn:sequenceFlow id="Flow_FimModuloAtendimento" sourceRef="SubProcess_RealizarAtendimento" targetRef="EndEvent_ModuloAtendimento" />
    <bpmn:startEvent id="StartEvent_ModuloFinanceiro" name="Receber Solicitação de Gestão Financeira">
      <bpmn:messageEventDefinition messageRef="Msg_SolicitacaoFinanceiro" />
    </bpmn:startEvent>
    <bpmn:subProcess id="SubProcess_GerenciarFinanceiro" name="Gerenciar Contas a Pagar e Receber" />
    <bpmn:endEvent id="EndEvent_ModuloFinanceiro" name="Resposta de Gestão Financeira Enviada" />
    <bpmn:sequenceFlow id="Flow_InicioModuloFinanceiro" sourceRef="StartEvent_ModuloFinanceiro" targetRef="SubProcess_GerenciarFinanceiro" />
    <bpmn:sequenceFlow id="Flow_FimModuloFinanceiro" sourceRef="SubProcess_GerenciarFinanceiro" targetRef="EndEvent_ModuloFinanceiro" />
    <bpmn:startEvent id="StartEvent_ModuloRelatorios" name="Receber Solicitação de Relatório">
      <bpmn:messageEventDefinition messageRef="Msg_SolicitacaoRelatorios" />
    </bpmn:startEvent>
    <bpmn:subProcess id="SubProcess_GerarRelatorios" name="Gerar Relatórios Contábeis/Gerenciais" />
    <bpmn:endEvent id="EndEvent_ModuloRelatorios" name="Relatório Gerado e Enviado" />
    <bpmn:sequenceFlow id="Flow_InicioModuloRelatorios" sourceRef="StartEvent_ModuloRelatorios" targetRef="SubProcess_GerarRelatorios" />
    <bpmn:sequenceFlow id="Flow_FimModuloRelatorios" sourceRef="SubProcess_GerarRelatorios" targetRef="EndEvent_ModuloRelatorios" />
  </bpmn:process>
  <bpmn:message id="Msg_SolicitacaoAgendamento" name="SolicitacaoAgendamento" />
  <bpmn:message id="Msg_SolicitacaoPacientes" name="SolicitacaoPacientes" />
  <bpmn:message id="Msg_SolicitacaoCadastros" name="SolicitacaoCadastros" />
